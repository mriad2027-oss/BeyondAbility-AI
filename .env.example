# Copy this file to ".env" in the project root and fill in what you have.
# EVERYTHING is optional -- the app works fully offline with zero keys.
# Adding a key just upgrades the quality of that one component.

# ---------------------------------------------------------------------------
# Hugging Face Cloud (Centralized AI Gateway)
# ---------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
HF_GEMMA_MODEL=google/gemma-3-4b-it
HF_VOXCPM_MODEL=your_voxcpm_model
HF_PROVIDER=auto
HF_GEMMA_ENDPOINT=
HF_VOXCPM_ENDPOINT=

# ---------------------------------------------------------------------------
# Speech-to-text (Whisper) -- runs locally or via HF Cloud.
# Options: tiny, base, small, medium, large  (bigger = slower but more accurate)
# ---------------------------------------------------------------------------
WHISPER_MODEL_SIZE=medium

# ---------------------------------------------------------------------------
# Vision (describes what's on screen in each frame)
# Leave VISION_PROVIDER=auto to automatically use HF/Gemma/OpenAI/Anthropic if configured,
# otherwise it silently falls back to offline OCR.
# ---------------------------------------------------------------------------
VISION_PROVIDER=auto
VISION_MODEL=

# ---------------------------------------------------------------------------
# LLM (combines transcript + visual info, tutor, quiz, RAG, global assistant)
# "auto" uses Gemma via HF Cloud if HF_TOKEN is set, else fallbacks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
LLM_MODEL=

# ---------------------------------------------------------------------------
# Legacy API keys (optional fallback)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Text-to-speech. "auto" uses VoxCPM via HF if available, else pyttsx3
# ---------------------------------------------------------------------------
TTS_PROVIDER=auto

# ---------------------------------------------------------------------------
# Frame sampling
# ---------------------------------------------------------------------------
FRAME_INTERVAL_SECONDS=5
FRAME_MIN_INTERVAL=2.0
SCENE_CHANGE_THRESHOLD=5.0

